+static char *
+ngx_openssl_keylog(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
+{
+    ngx_openssl_conf_t  *oscf = conf;
+    ngx_str_t           *value;
+
+    if (oscf->keylog != NULL) {
+        return "is duplicate";
+    }
+
+    value = cf->args->elts;
+    oscf->keylog = ngx_conf_open_file(cf->cycle, &value[1]);
+    if (oscf->keylog == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    return NGX_CONF_OK;
+}
