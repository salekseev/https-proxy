+static void
+ngx_ssl_keylog_callback(const ngx_ssl_conn_t *ssl_conn, const char *line)
+{
+    size_t               len;
+    ssize_t              n;
+    ngx_openssl_conf_t  *oscf;
+    u_char               record[1024];
+
+    oscf = (ngx_openssl_conf_t *) ngx_get_conf(ngx_cycle->conf_ctx,
+                                              ngx_openssl_module);
+    if (oscf == NULL || oscf->keylog == NULL
+        || oscf->keylog->fd == NGX_INVALID_FILE)
+    {
+        return;
+    }
+
+    len = ngx_strlen(line);
+    if (len >= sizeof(record)) {
+        ngx_log_error(NGX_LOG_ERR, ngx_cycle->log, 0,
+                      "SSL key log record exceeds buffer size");
+        return;
+    }
+
+    ngx_memcpy(record, line, len);
+    record[len++] = LF;
+
+    /* One append write per record prevents interleaving between workers. */
+    do {
+        n = ngx_write_fd(oscf->keylog->fd, record, len);
+    } while (n == -1 && ngx_errno == NGX_EINTR);
+
+    if (n == -1) {
+        ngx_log_error(NGX_LOG_ERR, ngx_cycle->log, ngx_errno,
+                      "writing SSL key log failed");
+
+    } else if ((size_t) n != len) {
+        ngx_log_error(NGX_LOG_ERR, ngx_cycle->log, 0,
+                      "incomplete SSL key log write");
+    }
 }
 
 
